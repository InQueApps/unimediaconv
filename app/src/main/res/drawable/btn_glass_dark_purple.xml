<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#304A1942">
    <item>
        <layer-list>
            <!-- Transparent purple tint (glassy) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#224A1942" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Glassy purple edge - pops more -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="#CC4A1942" />
                    <corners android:radius="14dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
