<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background: preserve aspect ratio -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- Top overlay: title centered, then points + buttons + info on one line -->
        <FrameLayout
            android:id="@+id/conversionsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Row 1: App title (centered) + info icon right -->
                <LinearLayout
                    android:id="@+id/conversionsBarFirstRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/conversionsBarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_glass_text"
                        android:gravity="center" />

                    <ImageView
                        android:id="@+id/infoButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_info"
                        android:tint="@color/btn_glass_text"
                        android:contentDescription="Show converter information"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Row 2: Points centered, Add points + Premium on the right (hidden when premium) -->
                <LinearLayout
                    android:id="@+id/conversionsBarSecondRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/conversionsLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_blue_800"
                        android:gravity="center" />

                    <ImageView
                        android:id="@+id/currencyIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_currency_c"
                        android:contentDescription="Conversion points"
                        android:layout_marginStart="4dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/watchVideosButton"
                        style="@style/Widget.UniversalConverter.Button.Glass"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/button_get_more_points"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_video"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unlockFullButton"
                        style="@style/Widget.UniversalConverter.Button.Glass"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/button_unlock_full"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_crown"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Step 1: File & format – one overlay (same glass style) -->
        <FrameLayout
            android:id="@+id/fileSelectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Select file"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectFileButton"
                    style="@style/Widget.UniversalConverter.Button.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/button_choose_files"
                    android:textSize="16sp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconGravity="textStart"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/selectedFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    android:background="@drawable/file_name_background"
                    android:padding="12dp"
                    android:gravity="center" />

                <ScrollView
                    android:id="@+id/selectedFilesListScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:maxHeight="160dp"
                    android:fillViewport="false"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/selectedFilesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- Step 2: Convert to – overlay, only when file(s) selected -->
        <FrameLayout
            android:id="@+id/convertToCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Convert to"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/toFormatSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Select target format"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Image scaling (when image selected) – same overlay style -->
        <FrameLayout
            android:id="@+id/imageScalingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image size (optional)"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/originalImageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original size: 1920 x 1080"
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/format_background"
                    android:padding="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set new dimensions (aspect ratio will be maintained):"
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/dimensionRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RadioButton
                        android:id="@+id/widthRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Width"
                        android:layout_marginEnd="16dp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/heightRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height"
                        android:layout_marginEnd="16dp" />

                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/newDimensionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:hint="Enter new dimension"
                            android:text="1920" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/dimensionUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="px"
                        android:textSize="16sp"
                        android:textColor="@color/btn_glass_text"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/newSizePreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New size: 1920 x 1080"
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/format_background"
                    android:padding="8dp"
                    android:gravity="center" />

            </LinearLayout>
        </FrameLayout>

        <!-- Media Tools (optional) – shown for video, audio, or image -->
        <FrameLayout
            android:id="@+id/mediaToolsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_media_tools"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="16dp" />

                <!-- Trim -->
                <LinearLayout
                    android:id="@+id/trimSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/trimCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_trim"
                        android:textColor="@color/btn_glass_text"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/trimInputs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/trimRangeSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1"
                            app:labelBehavior="gone"
                            app:trackColorActive="@color/dark_blue_800"
                            app:trackColorInactive="@color/blue_200"
                            app:thumbColor="@color/dark_blue_800" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/trimStartLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0:00"
                                android:textSize="13sp"
                                android:textColor="@color/btn_glass_text"
                                android:gravity="start" />

                            <TextView
                                android:id="@+id/trimEndLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0:00"
                                android:textSize="13sp"
                                android:textColor="@color/btn_glass_text"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Speed -->
                <LinearLayout
                    android:id="@+id/speedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/speedCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_change_speed"
                        android:textColor="@color/btn_glass_text"
                        android:textSize="15sp" />

                    <HorizontalScrollView
                        android:id="@+id/speedOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:visibility="gone"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp">

                        <RadioGroup
                            android:id="@+id/speedGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/speed025"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_025"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed05"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_05"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed075"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_075"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_1"
                                android:textColor="@color/btn_glass_text"
                                android:checked="true"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_15"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_2"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_3"
                                android:textColor="@color/btn_glass_text"
                                android:layout_marginEnd="8dp" />

                            <RadioButton
                                android:id="@+id/speed4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_4"
                                android:textColor="@color/btn_glass_text" />
                        </RadioGroup>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Flip / Mirror -->
                <LinearLayout
                    android:id="@+id/flipSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_flip"
                        android:textColor="@color/btn_glass_text"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp" />

                    <CheckBox
                        android:id="@+id/flipHorizontalCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_flip_horizontal"
                        android:textColor="@color/btn_glass_text"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp" />

                    <CheckBox
                        android:id="@+id/flipVerticalCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_flip_vertical"
                        android:textColor="@color/btn_glass_text"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Step 3: Convert – same overlay style -->
        <FrameLayout
            android:id="@+id/conversionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/conversionCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Convert"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="16dp" />

                <!-- Quality selector: visible for image and video sources -->
                <LinearLayout
                    android:id="@+id/qualityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_quality"
                        android:textSize="14sp"
                        android:textColor="@color/btn_glass_text"
                        android:layout_marginBottom="6dp" />

                    <RadioGroup
                        android:id="@+id/qualityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/qualityLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quality_low"
                            android:textColor="@color/btn_glass_text"
                            android:layout_marginEnd="16dp" />

                        <RadioButton
                            android:id="@+id/qualityMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quality_medium"
                            android:textColor="@color/btn_glass_text"
                            android:checked="true"
                            android:layout_marginEnd="16dp" />

                        <RadioButton
                            android:id="@+id/qualityHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quality_high"
                            android:textColor="@color/btn_glass_text" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/outputOptionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_output_as"
                        android:textSize="14sp"
                        android:textColor="@color/btn_glass_text"
                        android:layout_marginBottom="6dp" />

                    <RadioGroup
                        android:id="@+id/outputOptionGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/outputOptionZip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/option_output_zip"
                            android:textColor="@color/btn_glass_text"
                            android:layout_marginEnd="20dp" />

                        <RadioButton
                            android:id="@+id/outputOptionSeparate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/option_output_separate"
                            android:textColor="@color/btn_glass_text" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/convertButton"
                        style="@style/Widget.UniversalConverter.Button.Filled"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Convert"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resetButton"
                        style="@style/Widget.UniversalConverter.Button.Glass"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Reset"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_revert"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Progress – same overlay style -->
        <FrameLayout
            android:id="@+id/progressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Converting..."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="20dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="16dp"
                    android:progressTint="@color/btn_filled_dark_blue" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preparing file..."
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:alpha="0.8"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.UniversalConverter.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Cancel"
                    android:textSize="16sp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </FrameLayout>

        <!-- Result – same overlay style -->
        <FrameLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conversion Complete!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/convertedFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:background="@drawable/file_name_background"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/fileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:alpha="0.8"
                    android:layout_marginBottom="20dp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewFileButton"
                        style="@style/Widget.UniversalConverter.Button.Glass"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="View File"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_view"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareFileButton"
                        style="@style/Widget.UniversalConverter.Button.Glass"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Share File"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_share"
                        app:iconGravity="textStart" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveToDownloadsButton"
                    style="@style/Widget.UniversalConverter.Button.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save to Downloads"
                    android:textSize="16sp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </FrameLayout>

        <!-- Result (multiple files) – list + View / Share / Save -->
        <FrameLayout
            android:id="@+id/resultCardMulti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conversion Complete!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_glass_text"
                    android:layout_marginBottom="12dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="320dp"
                    android:fillViewport="false">

                    <LinearLayout
                        android:id="@+id/convertedFilesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- Error – same overlay style -->
        <FrameLayout
            android:id="@+id/errorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_glass"
            android:padding="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❌ Error"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/main_on_error_container"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/main_on_error_container"
                    android:gravity="center"
                    android:alpha="0.9"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/errorStartOverButton"
                    style="@style/Widget.UniversalConverter.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/button_start_over"
                    android:textSize="16sp"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </FrameLayout>

        <!-- Contact us at bottom -->
        <TextView
            android:id="@+id/contactUsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:padding="4dp"
            android:text="Contact us"
            android:textSize="14sp"
            android:textColor="@color/btn_glass_text"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>
    </ScrollView>
</FrameLayout> 