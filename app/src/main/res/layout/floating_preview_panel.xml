<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingPreviewCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/preview_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeColor="@color/preview_accent"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drag header -->
            <LinearLayout
                android:id="@+id/previewDragHeader"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/preview_scrim"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/preview_muted" />

                <TextView
                    android:id="@+id/previewHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/preview_title"
                    android:textColor="@color/preview_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/previewCloseButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/preview_close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/preview_on_surface" />
            </LinearLayout>

            <!-- Preview content -->
            <FrameLayout
                android:id="@+id/previewContentArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/previewPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:show_buffering="when_playing"
                    app:show_subtitle_button="false"
                    app:show_vr_button="false"
                    app:surface_type="texture_view"
                    app:use_controller="true" />

                <LinearLayout
                    android:id="@+id/previewAudioPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/preview_audio_mode"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="@color/preview_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/preview_audio_mode"
                        android:textColor="@color/preview_on_surface"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/previewPhotoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/button_preview"
                    android:visibility="gone" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/previewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/previewTextScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/previewTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/preview_on_surface"
                        android:textSize="14sp" />
                </androidx.core.widget.NestedScrollView>

                <WebView
                    android:id="@+id/previewWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/previewLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/preview_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/preview_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/preview_loading"
                        android:textColor="@color/preview_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewErrorPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/previewErrorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/preview_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Footer -->
            <LinearLayout
                android:id="@+id/previewFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/preview_scrim"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/previewSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/preview_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewDisclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/preview_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewPageIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/preview_accent"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Resize grip -->
        <ImageView
            android:id="@+id/previewResizeHandle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/preview_resize"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="@color/preview_accent" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
