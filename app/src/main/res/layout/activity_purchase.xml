<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/title_purchase"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/btn_glass_text"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="@string/purchase_description"
                android:textSize="16sp"
                android:textColor="@color/btn_glass_text"
                android:gravity="center" />

            <TextView
                android:id="@+id/purchaseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/purchase_status_connecting"
                android:textSize="13sp"
                android:textColor="@color/btn_glass_text"
                android:alpha="0.9"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyButton"
                style="@style/Widget.UniversalConverter.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/button_buy_price"
                android:textSize="18sp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_have_unlock_link"
                android:textSize="14sp"
                android:textColor="@color/btn_glass_text"
                android:alpha="0.9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/unlockUriInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_unlock_uri"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textColor="@color/btn_glass_text"
                    android:textColorHint="@color/btn_glass_text"
                    android:alpha="0.9"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unlockWithUriButton"
                    style="@style/Widget.UniversalConverter.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_unlock_with_uri"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
