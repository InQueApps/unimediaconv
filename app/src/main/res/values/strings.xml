    <!-- Info dialog -->
    <string name="info_dialog_title">AnyConvert</string>
    <string name="info_dialog_intro">Convert images, video, audio, and documents in one place.</string>
    <string name="info_dialog_description">Select a file, choose a target format, and convert. Optional image scaling helps reduce file size. All conversions run on your device—your files stay private.</string>
    <string name="info_dialog_section_images">Images</string>
    <string name="info_dialog_images">• JPEG ↔ PNG\n• HEIC → JPEG/PNG (iPhone photos; .heic and .heif)\n• PNG → JPG (smaller size)\n• WEBP → JPG or PNG (from websites)\n• BMP, TIFF → PNG/JPEG\n• Any image → single-page PDF</string>
    <string name="info_dialog_section_video">Video</string>
    <string name="info_dialog_video">• MOV → MP4 (Apple → universal)\n• MP4 → MOV\n• MOV/MP4 ↔ WEBM, AVI, MKV (re-encode)\n• Video → M4A (fast lossless audio extract)\n• Video → WAV (decoded audio)</string>
    <string name="info_dialog_section_audio">Audio</string>
    <string name="info_dialog_audio">• WAV, M4A, MP3 → WAV (full quality decode)\n• WAV or MP3 → M4A (AAC encode; compact)\n• Video → WAV (extract and decode audio)\n• Video → M4A (fast lossless audio extract)</string>
    <string name="info_dialog_section_documents">Documents</string>
    <string name="info_dialog_documents">• PDF ↔ EPUB, DOCX, RTF, TXT\n• Images → PDF (one image = one page)\n• PDF → images: each page exported as JPG or PNG (delivered as a zip)</string>
    <string name="info_dialog_formats_heading">Supported file types</string>
    <string name="info_dialog_formats">Documents: PDF, EPUB, DOCX, TXT, RTF\nImages: JPG, PNG, WEBP, HEIC, BMP, TIFF\nVideo: MP4, MOV, AVI, MKV, WEBM, GIF\nAudio: MP3, WAV, M4A</string>

